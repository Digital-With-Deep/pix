{
  "name": "pix-monorepo",
  "private": true,
  "description": "PIX — Primitives for Intelligent eXperiences. An open-source design system for AI products, on every platform.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "node scripts/smoke-test.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=18" }
}
