{
  "name": "@pix-ui/a2ui",
  "version": "0.1.0",
  "description": "Render A2UI (Agent-to-User Interface) v1.0 surfaces with PIX (Primitives for Intelligent eXperiences) components: a PIX component catalog and a React renderer.",
  "license": "MIT",
  "author": "Mandeep Sidhu (#digitalwithdeep)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital-With-Deep/pix.git",
    "directory": "packages/a2ui"
  },
  "homepage": "https://pixui.digitalwithdeep.com/docs/a2ui",
  "keywords": [
    "pix",
    "a2ui",
    "agent",
    "generative-ui",
    "react",
    "design-system",
    "catalog"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/write-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "peerDependencies": {
    "react": ">=18",
    "@pix-ui/react": ">=0.2.0"
  },
  "devDependencies": {
    "@pix-ui/react": "workspace:^",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
