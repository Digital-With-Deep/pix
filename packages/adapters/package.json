{
  "name": "@pix-ui/adapters",
  "version": "0.0.0",
  "description": "PIX (Primitives for Intelligent eXperiences) adapters: turn Vercel AI SDK, AG-UI and Google ADK agent event streams into props for PIX components.",
  "license": "MIT",
  "author": "Mandeep Sidhu (#digitalwithdeep)",
  "repository": { "type": "git", "url": "git+https://github.com/Digital-With-Deep/pix.git", "directory": "packages/adapters" },
  "homepage": "https://github.com/Digital-With-Deep/pix/tree/main/packages/adapters#readme",
  "keywords": ["pix", "agents", "ai", "streaming", "ai-sdk", "ag-ui", "adk", "design-system"],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup && cp src/index.d.ts dist/index.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": { "tsup": "^8.3.0", "typescript": "^5.6.0" },
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" }
}
